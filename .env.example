# No environment variables are required to run this application.
#
# It has no database, no API keys and no third-party services: speech
# recognition runs in the browser and the NLP, catalog, search and
# recommendation engines are all local Python. This file exists to document
# that, and to list the few optional knobs the host may set.

# Port to bind. Every supported platform sets this automatically; only set it
# yourself when running locally on a non-default port.
# PORT=8000

# Uvicorn log level: critical | error | warning | info | debug | trace
# LOG_LEVEL=info
